!Hermod/Hermod/HTTP/HTTPAPI/HTTPRoot/js/
!Hermod/Hermod/HTTP/HTTPAPI/HTTPRoot/js/**


# QUIC/TLS debug output and secrets (Hermod/QUIC). None of these are confined to
# bin/: --qlog=<dir>, SSLKEYLOGFILE and a caller-chosen secret path all write
# wherever they are told to, and a TLS key log deanonymises a whole capture.
*.qlog
*.sqlog
sslkeylog.txt
stateless-reset-secret.bin

# 'dotnet test --blame-hang' writes a full process dump per aborted run in here.
# Those are hundreds of megabytes each and must never end up in the history.
TestResults/

# Where both workflows point --results-directory for their .trx logs. On a runner
# that is a throwaway directory an upload-artifact step collects; run the same
# command locally to reproduce a CI result and it lands in the working tree.
artifacts/
