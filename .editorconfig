# Analyzer settings for this repository.
root = true

# CA2007 - every await in the DNS library says which context it resumes on.
#
# Library code that resumes on the caller's synchronization context can
# deadlock a caller that blocks on the result, in a UI application or in
# classic ASP.NET. The convention here is ConfigureAwait(false) and most awaits
# already followed it; the rule makes the rest say so, and keeps it that way.
# It accepts ConfigureAwait(true) just as readily: what it enforces is that the
# choice is made, not which one.
#
# Scoped to DNS, the part of the library a conformance suite measures. The
# rest of the library would raise it about fifteen hundred times.
[Hermod/DNS/**.cs]
dotnet_diagnostic.CA2007.severity = warning

# NUnit1034 - a test fixture that is used as a base class should be abstract.
#
# Here a concrete base class is the pattern, not a slip: an HTTP/2 fixture
# runs, and an empty class of the same name derives from it in
# Hermod.Tests.HTTP3, so the HTTP/3 conformance repository, which selects its
# tests by that namespace, runs them too (WebSocketFrameReadTests,
# WebSocketMessageLimitTests, WebSocketDeflateNegotiationTests). Making the
# base abstract would drop the HTTP/2 runs.
[HermodTests/**.cs]
dotnet_diagnostic.NUnit1034.severity = none
