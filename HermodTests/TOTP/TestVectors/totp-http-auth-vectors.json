{
  "$comment": "GENERATED by tools/generate-test-vectors.py - do not edit by hand. Regenerate with: python tools/generate-test-vectors.py",
  "specification": "Open Charging Cloud TOTP HTTP Authentication 1.0 (draft)",
  "description": "The 'Authorization: TOTP' scheme: TOTP <type> base64(identity):base64(totp). 'vectors' round-trip (build the header from the input AND parse it back), 'parseVectors' are parse-only leniency cases, 'invalidHeaders' MUST be rejected by parsers. The whole file requires the listed capabilities; harnesses without them skip it declaratively.",
  "requires": [
    "httpAuthentication"
  ],
  "vectors": [
    {
      "id": "raw-defaults",
      "description": "A raw token (type 0) for a plain ASCII identity.",
      "input": {
        "username": "chargingstation-0001",
        "totp": "CN63y502maVh",
        "type": 0
      },
      "expected": {
        "header": "TOTP 0 Y2hhcmdpbmdzdGF0aW9uLTAwMDE=:Q042M3k1MDJtYVZo"
      }
    },
    {
      "id": "tls-channel-bound",
      "description": "A TLS-channel-bound token (type 1).",
      "input": {
        "username": "chargingstation-0001",
        "totp": "gAzxPfYtmRgd",
        "type": 1
      },
      "expected": {
        "header": "TOTP 1 Y2hhcmdpbmdzdGF0aW9uLTAwMDE=:Z0F6eFBmWXRtUmdk"
      }
    },
    {
      "id": "username-with-colon",
      "description": "Identity and token are Base64-encoded separately, so a colon in the identity - HTTP Basic Auth's classic ambiguity - is harmless.",
      "input": {
        "username": "EVSE:DE*GEF*E1234*1",
        "totp": "CN63y502maVh",
        "type": 0
      },
      "expected": {
        "header": "TOTP 0 RVZTRTpERSpHRUYqRTEyMzQqMQ==:Q042M3k1MDJtYVZo"
      }
    },
    {
      "id": "username-utf8",
      "description": "A non-ASCII identity is UTF-8 encoded before Base64.",
      "input": {
        "username": "Lades\u00e4ule-S\u00fcd-01",
        "totp": "SLuwWQOYh3g0",
        "type": 0
      },
      "expected": {
        "header": "TOTP 0 TGFkZXPDpHVsZS1Tw7xkLTAx:U0x1d1dRT1loM2cw"
      }
    },
    {
      "id": "short-token",
      "description": "A six character token (the OCPP minimum length).",
      "input": {
        "username": "chargingstation-0001",
        "totp": "Ik0dNs",
        "type": 0
      },
      "expected": {
        "header": "TOTP 0 Y2hhcmdpbmdzdGF0aW9uLTAwMDE=:SWswZE5z"
      }
    }
  ],
  "parseVectors": [
    {
      "id": "scheme-lowercase",
      "description": "The scheme name is matched case-insensitively.",
      "header": "totp 0 Y2hhcmdpbmdzdGF0aW9uLTAwMDE=:Q042M3k1MDJtYVZo",
      "expected": {
        "username": "chargingstation-0001",
        "totp": "CN63y502maVh",
        "type": 0
      }
    },
    {
      "id": "scheme-mixed-case",
      "description": "The scheme name is matched case-insensitively.",
      "header": "tOtP 1 Y2hhcmdpbmdzdGF0aW9uLTAwMDE=:Z0F6eFBmWXRtUmdk",
      "expected": {
        "username": "chargingstation-0001",
        "totp": "gAzxPfYtmRgd",
        "type": 1
      }
    }
  ],
  "invalidHeaders": [
    {
      "id": "missing-type-digit",
      "description": "The type digit is mandatory.",
      "header": "TOTP Y2hhcmdpbmdzdGF0aW9uLTAwMDE=:Q042M3k1MDJtYVZo"
    },
    {
      "id": "colon-separated-type",
      "description": "The colon-separated type of an earlier draft is not the format.",
      "header": "TOTP 1:Y2hhcmdpbmdzdGF0aW9uLTAwMDE=:Q042M3k1MDJtYVZo"
    },
    {
      "id": "unknown-type-digit",
      "description": "Only the type digits 0 and 1 exist.",
      "header": "TOTP 2 Y2hhcmdpbmdzdGF0aW9uLTAwMDE=:Q042M3k1MDJtYVZo"
    },
    {
      "id": "type-without-credentials",
      "description": "A type digit alone is not a credential.",
      "header": "TOTP 1"
    },
    {
      "id": "missing-colon",
      "description": "The credential must contain base64(identity):base64(totp).",
      "header": "TOTP 0 Y2hhcmdpbmdzdGF0aW9uLTAwMDE="
    },
    {
      "id": "three-segments",
      "description": "Exactly one colon separates identity and token.",
      "header": "TOTP 0 YQ==:YQ==:YQ=="
    },
    {
      "id": "extra-parameter",
      "description": "Nothing follows the credential.",
      "header": "TOTP 0 Y2hhcmdpbmdzdGF0aW9uLTAwMDE=:Q042M3k1MDJtYVZo extra"
    },
    {
      "id": "username-not-base64",
      "description": "The identity segment must be valid Base64.",
      "header": "TOTP 0 not-base64!:Q042M3k1MDJtYVZo"
    },
    {
      "id": "totp-not-base64",
      "description": "The token segment must be valid Base64.",
      "header": "TOTP 0 Y2hhcmdpbmdzdGF0aW9uLTAwMDE=:not-base64!"
    },
    {
      "id": "wrong-scheme",
      "description": "A different authentication scheme is not ours to parse.",
      "header": "Basic 0 Y2hhcmdpbmdzdGF0aW9uLTAwMDE=:Q042M3k1MDJtYVZo"
    },
    {
      "id": "empty",
      "description": "An empty header value is rejected.",
      "header": ""
    },
    {
      "id": "scheme-only",
      "description": "The scheme name alone is not a credential.",
      "header": "TOTP"
    }
  ]
}
